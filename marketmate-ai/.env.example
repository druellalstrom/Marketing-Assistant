# Copy to .env.local and fill in. Never commit .env.local.

# --- Supabase (Project Settings → API) ---
# Public by design; protected by Row Level Security.
NEXT_PUBLIC_SUPABASE_URL=
# The "publishable" key (sb_publishable_...). The legacy anon key also works:
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Public URL of this app, used for auth email redirect links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- AI writing (server-side only — never prefix with NEXT_PUBLIC_) ---
# Google Gemini (free tier available): https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional model override (defaults to gemini-flash-latest).
# GEMINI_MODEL=gemini-flash-latest

# Optional alternative: Anthropic. Used only when GEMINI_API_KEY is empty,
# or when AI_PROVIDER=anthropic.
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5
# Force a provider ("gemini" or "anthropic"); by default Gemini wins if its key is set.
# AI_PROVIDER=gemini

# --- Design Studio image generation (server-side only) ---
# "none" (no images), "gemini" (uses GEMINI_API_KEY above) or "pollinations".
IMAGE_PROVIDER=none
# Optional Gemini image model override (defaults to gemini-2.5-flash-image).
# GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
# For Pollinations, create a secret key (sk_...) at https://enter.pollinations.ai.
# POLLINATIONS_API_KEY=
# Optional model override; Pollinations' default is its cheapest model.
# POLLINATIONS_MODEL=
