# Copy to .env.local and fill in. Never commit .env.local.

# --- Supabase (Project Settings → API) ---
# Public by design; protected by Row Level Security.
NEXT_PUBLIC_SUPABASE_URL=
# The "publishable" key (sb_publishable_...). The legacy anon key also works:
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Public URL of this app, used for auth email redirect links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Anthropic (server-side only — never prefix with NEXT_PUBLIC_) ---
ANTHROPIC_API_KEY=
# Optional model override (defaults to claude-opus-5).
# ANTHROPIC_MODEL=claude-opus-5

# --- Design Studio image generation ---
# Not connected yet. Only "none" is implemented; see src/lib/design/provider.ts.
IMAGE_PROVIDER=none
